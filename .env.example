# Optional automatic S2 refresh credentials for local CLI/app runs.
# If these are blank, users can enter S2 ID/PW in the app sidebar.
S2_API_BASE_URL=https://kiss-api.kld.kr
S2_ID=
S2_PW=
# Optional: if set, S2 refresh skips the login request and uses this bearer token.
S2_ACCESS_TOKEN=
IPS_ID=
IPS_PW=

# Legacy aliases are still supported for existing local setups.
KISS_BASE_URL=https://kiss.kld.kr
KISS_API_BASE_URL=https://kiss-api.kld.kr
KIPM_BASE_URL=https://kiss.kld.kr
KISS_ID=
KISS_PW=
KIPM_ID=
KIPM_PW=
KLD_LOGIN_ID=
KLD_LOGIN_PW=
# Optional Barobook/admin/account-specific aliases.
# If blank, admin/account helpers fall back to KLD_LOGIN_ID/KLD_LOGIN_PW.
BAROBOOK_ID=
BAROBOOK_PW=

# Optional Notion task creation for the S2 request, adapter failure, and mapping run cards.
# Keep the real token only in local .env or Streamlit Cloud Secrets.
NOTION_TOKEN=
NOTION_TASK_DATA_SOURCE_ID=465360d4-1b25-49cf-a859-f33dd5da4209
NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11
NOTION_APP_URL=https://mapping-novel-ascmdzm897irzyvzwn9kqo.streamlit.app/
NOTION_ATTACH_FILES=true
NOTION_ATTACH_ORIGINAL_XLSX=true
# 0 means use the workspace/bot upload limit when Notion exposes it.
NOTION_MAX_ATTACHMENT_BYTES=0

# Optional GitHub issue creation for sanitized adapter failure tracking.
GITHUB_ADAPTER_FAILURE_TOKEN=
GITHUB_ADAPTER_FAILURE_REPO=macximin/mapping-novel
GITHUB_ADAPTER_FAILURE_ASSIGNEES=
GITHUB_ADAPTER_FAILURE_MENTIONS=
GITHUB_ADAPTER_FAILURE_LABELS=adapter-failure,urgent
